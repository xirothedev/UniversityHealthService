# Copy to .env and fill in the real values. NEVER commit .env.
# Lookup order in code: real ENV > .env file > db.properties > defaults.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uhs_db
DB_USERNAME=uhs_app
DB_PASSWORD=change_me

# Local MySQL 8.4 (lab/grader machine):
# DB_PARAMS=useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Temporary TiDB Cloud dev DB (TLS required, MySQL 8.4 stays the submission SSOT):
DB_PARAMS=sslMode=VERIFY_IDENTITY&serverTimezone=UTC
